# Copy to .env and edit. Everything is optional; the stack runs with no
# configuration at all. Secrets are references only — put real values in
# your local .env (gitignored), never in committed files.

# --- Secrets (leave empty here; set in local .env) ---
# Anthropic API key for the adaptive service. Empty = offline stub mode.
ANTHROPIC_API_KEY=

# Scorpio Postgres password shared by scorpio-postgres and scorpio.
# Compose default is a local demo value when unset.
#SCORPIO_PG_PASSWORD=

# --- Image tags / broker image ---
# Tag for published pne-ce-* images (compose default: 0.1.0).
#PNE_VERSION=0.1.0

# Swap the broker image, e.g. for a from-source build
# (see broker/build/README.md).
#PNE_SCORPIO_IMAGE=scorpiobroker/all-in-one-runner:java-6.0.1

# --- Demo defaults (config — override for your environment) ---
# Adaptive model (used only when ANTHROPIC_API_KEY is set).
#PNE_ADAPTIVE_MODEL=claude-opus-4-8

# Study id used by the adaptive stub and id examples.
#PNE_STUDY_ID=CARDIO-118

# Enable adaptive /commit writes (default: deny).
#PNE_ADAPTIVE_EXECUTE=false

# Optional JSON overrides for allow-lists / subscription watch types.
# When unset, services load adaptive/allowed.json and
# pipeline/subscriptions/watched-types.json.
#PNE_ADAPTIVE_ALLOWED_JSON=
#PNE_WATCHED_TYPES=

# Optional path overrides (parity with the JSON env overrides above).
# Default paths are adaptive/allowed.json and
# pipeline/subscriptions/watched-types.json inside each image.
#PNE_ADAPTIVE_ALLOWED_PATH=
#PNE_WATCHED_TYPES_PATH=

# --- Host ports (compose defaults; remap via docker-compose.local-run.yaml) ---
# Scorpio broker: 9090
# Web UI / proxy: 8080
# USDM: 8101  Projection: 8102  Subscriptions: 8103
# Transform: 8104  Lake: 8105  Adaptive: 8106  Bridge: 8107
